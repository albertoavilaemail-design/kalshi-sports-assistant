# systemd unit for an always-on Linux box (Raspberry Pi, VPS).
# sudo cp deploy/kalshi-assistant.service /etc/systemd/system/ && sudo systemctl enable --now kalshi-assistant
[Unit]
Description=Kalshi sports assistant live monitor (recommendations + paper trading only)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/kalshi-sports-assistant
EnvironmentFile=/home/pi/kalshi-sports-assistant/.env
ExecStart=/home/pi/kalshi-sports-assistant/.venv/bin/kalshi-assistant monitor --loop --interval 60
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
