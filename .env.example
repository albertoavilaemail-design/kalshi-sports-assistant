# Copy to .env (never commit .env). All values below are placeholders.
# --- Kalshi (optional; only needed for read-only balance/positions) ---
KALSHI_ENV=prod
KALSHI_API_KEY_ID=your-kalshi-key-id
# Either paste the PEM with \n for newlines, or point to a file outside the repo:
KALSHI_PRIVATE_KEY_PATH=/path/outside/repo/kalshi-private-key.pem
# KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- Optional data/explanations ---
FOOTBALL_DATA_API_KEY=
ANTHROPIC_API_KEY=

# --- Local paths ---
KSA_CONFIG=config/settings.yaml
KSA_DB_PATH=data/assistant.db
